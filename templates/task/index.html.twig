{# templates/task/index.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
    <h1 class="mb-3">Mes tâches</h1>

    <form method="get" class="mb-3">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <input name="q" value="{{ filters.q }}" class="form-control" style="max-width:240px" placeholder="Recherche">

            <select name="status" class="form-select" style="max-width:120px">
                <option value="">--</option>
                <option value="todo"  {{ filters.status == 'todo'  ? 'selected' }}>todo</option>
                <option value="doing" {{ filters.status == 'doing' ? 'selected' }}>doing</option>
                <option value="done"  {{ filters.status == 'done'  ? 'selected' }}>done</option>
            </select>

            <select name="sort" class="form-select" style="max-width:140px">
                <option value="dueAt"     {{ filters.sort == 'dueAt' ? 'selected' }}>Deadline</option>
                <option value="createdAt" {{ filters.sort == 'createdAt' ? 'selected' }}>Création</option>
            </select>

            <select name="dir" class="form-select" style="max-width:110px">
                <option value="DESC" {{ filters.dir == 'DESC' ? 'selected' }}>Desc</option>
                <option value="ASC"  {{ filters.dir == 'ASC'  ? 'selected' }}>Asc</option>
            </select>

            <div class="form-check ms-2">
                <input class="form-check-input" type="checkbox" id="overdue" name="overdue" value="1" {{ filters.overdue ? 'checked' }}>
                <label class="form-check-label" for="overdue">En retard</label>
            </div>

            <a href="{{ path('task_new') }}" class="btn btn-success">+ Créer une tâche</a>
            <button class="btn btn-primary">Filtrer</button>

            <a class="btn btn-outline-secondary ms-auto"
               href="{{ path('task_export', {'_query': filters}) }}">
                Export CSV
            </a>
        </div>
    </form>

    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th style="width:45%">Titre</th>
                <th style="width:15%">Statut</th>
                <th style="width:10%">Priorité</th>
                <th style="width:20%">Échéance</th>
                <th class="text-end" style="width:10%">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for t in tasks %}
                {% set clsStatus = {'todo':'bg-secondary','doing':'bg-info text-dark','done':'bg-success'}[t.status]|default('bg-secondary') %}
                {% set clsPrio   = {'low':'bg-secondary','med':'bg-warning text-dark','high':'bg-danger'}[t.priority]|default('bg-secondary') %}
                {% set overdue   = t.dueAt and t.status != 'done' and t.dueAt|date('U') < 'now'|date('U') %}

                <tr class="{{ t.status == 'done' ? 'table-light' }}">
                    <td>
                        <div class="fw-semibold">{{ t.title }}</div>
                        {% if t.description %}
                            <div class="small text-muted">{{ t.description }}</div>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge {{ clsStatus }} text-uppercase">{{ t.status }}</span>
                    </td>
                    <td>
                        <span class="badge {{ clsPrio }}">prio {{ t.priority }}</span>
                    </td>
                    <td>
                        {% if t.dueAt %}
                            {{ t.dueAt|date('Y-m-d H:i') }}
                            {% if overdue %}
                                <span class="badge bg-danger ms-1">en retard</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a class="btn btn-outline-primary" href="{{ path('task_edit', {id: t.id}) }}">Éditer</a>
                            {% include 'task/_delete_form.html.twig' with { task: t } %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">Aucune tâche</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pages is defined and pages > 1 %}
        <nav class="mt-3">
            <ul class="pagination">
                <li class="page-item {{ page == 1 ? 'disabled' }}">
                    <a class="page-link" href="{{ path('task_index', filters|merge({'page': page-1})) }}">«</a>
                </li>
                {% for p in 1..pages %}
                    <li class="page-item {{ p == page ? 'active' }}">
                        <a class="page-link" href="{{ path('task_index', filters|merge({'page': p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {{ page == pages ? 'disabled' }}">
                    <a class="page-link" href="{{ path('task_index', filters|merge({'page': page+1})) }}">»</a>
                </li>
            </ul>
        </nav>
    {% endif %}
{% endblock %}
