{{ form_start(form) }}
<div class="row g-3">
    <div class="col-12">
        {{ form_row(form.title) }}
    </div>
    <div class="col-12">
        {{ form_row(form.description) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.priority) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.status) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.dueAt) }}
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <button class="btn btn-primary">
        {{ submit_label|default('Enregistrer') }}
    </button>
    <a class="btn btn-outline-secondary" href="{{ path('task_index') }}">Annuler</a>
</div>
{{ form_end(form) }}
