<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}ToDo{% endblock %}</title>

    {# Favicon par défaut Symfony #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    {# Bootstrap CSS (rapide) #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css" rel="stylesheet">

    {# Place pour tes styles persos si besoin #}
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark">
    <div class="container d-flex">
        <a class="navbar-brand" href="{{ path('task_index') }}">ToDo</a>
        <div class="ms-auto">
            {% if app.user %}
                <span class="text-light me-3">{{ app.user.email }}</span>
                <a class="btn btn-outline-light btn-sm" href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a class="btn btn-outline-light btn-sm" href="{{ path('app_login') }}">Login</a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container py-4">
    {# ✅ Flashs ici = visibles partout #}
    {% for label, messages in app.flashes %}
        {% for m in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'warning' }} my-2">{{ m }}</div>
        {% endfor %}
    {% endfor %}

    {# Contenu des pages #}
    {% block body %}{% endblock %}
</main>

{# Bootstrap JS (modales/menus) #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/js/bootstrap.bundle.min.js" defer></script>

{# Ton JS géré par ImportMap si tu en as #}
{% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
{% endblock %}
</body>
</html>
